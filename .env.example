# ---- Telegram (required) ----
# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session file name (creates <SESSION_NAME>.session). Use a unique name per account.
SESSION_NAME=solana_tracker
# Optional: phone number in international format, e.g. +15551234567.
# Telethon will prompt interactively if omitted.
TELEGRAM_PHONE=

# ---- GeckoTerminal (optional but recommended) ----
# Without a key the client is throttled to ~30 requests/minute (free public API).
# With a paid plan key it auto-bumps to ~250 requests/minute.
GECKOTERMINAL_API_KEY=

# ---- Database ----
# SQLite file path. Default: ./solana_tracker.db (relative to project root)
DB_PATH=solana_tracker.db

# ---- Backfill defaults ----
# Peak window after each call (hours). A call is a win if peak ROI >= WIN_MULTIPLIER within this window.
PEAK_WINDOW_HOURS=24
# Win threshold multiplier. 2.0 = a call must reach 2x (>=100% profit) to be a win.
WIN_MULTIPLIER=2.0
# Number of weekly buckets.
WINDOW_WEEKS=12
